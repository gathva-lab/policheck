# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica
# Clave service_role: SOLO server-side (nunca en el cliente). La usa el
# pipeline /api/analyze para escrituras internas (ai_reports, media_outlets,
# ai_cost_log, actualización de sources) que requieren eludir RLS.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# OpenRouter — pipeline de análisis IA (el route handler /api/analyze)
OPENROUTER_API_KEY=tu-openrouter-key

# Opcionales futuras (no usadas todavía por el pipeline)
# DEEPSEEK_API_KEY=
# NVIDIA_API_KEY=
